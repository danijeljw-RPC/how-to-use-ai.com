---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';

const policy = await getEntry('legal', 'terms-of-service');
if (!policy) throw new Error('Missing How-To-Use-AI.com website terms');
const { Content } = await render(policy);
---

<LegalLayout
  title="Website Terms"
  description="Terms for using How-To-Use-AI.com, its content, previews, forms, and direct sales."
  canonicalPath="/terms/"
>
  <Content />
  <section aria-labelledby="store-policy-note"><h2 id="store-policy-note">Direct digital purchases</h2><p>Your PDF or EPUB purchase gives you access to the latest available release of this book in the formats you bought, including future editions. Verify your purchase email to access your library. Download links expire after ten minutes; request fresh links from your library. Standard Amazon orders are placed with Amazon. Signed-copy orders, when offered here, are separately dispatched by the publisher.</p><p><a href="/downloads/">Open your book library</a></p></section>
</LegalLayout>
