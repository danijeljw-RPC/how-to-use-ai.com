---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<BaseLayout {title} {description} {canonicalPath}>
  <article class="page-section legal-page">
    <div class="narrow prose legal-document">
      <p class="kicker">Legal</p>
      <slot />
    </div>
  </article>
</BaseLayout>
