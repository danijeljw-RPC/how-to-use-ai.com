---
import { siteEnv } from '../lib/runtime-env';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
import { site } from '../content/site';
import { bookOne } from '../content/books';
import { storeReady } from '../lib/store/types';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  commerceEnabled?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  robots?: string;
}

const {
  title,
  description,
  canonicalPath,
  commerceEnabled,
  structuredData,
  robots = 'index, follow',
} = Astro.props;
const showLaunchCampaign = ['/', '/books/ai-for-normal-people/', '/preview/', '/purchase/'].includes(canonicalPath);
const runtimeEnv = siteEnv();
const resolvedCommerceEnabled = commerceEnabled ?? storeReady(runtimeEnv);
const turnstileSiteKey = runtimeEnv.TURNSTILE_SITE_KEY ?? '';
const canonical = new URL(canonicalPath, Astro.site);
const fullTitle = title.startsWith(site.name) ? title : `${title} | ${site.name}`;
const ogImage = new URL(bookOne.cover, Astro.site);
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replaceAll('<', '\\u003c') : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`Cover of ${bookOne.title}`} />
    <meta name="theme-color" content="#061532" />
    {structuredData && <script type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header commerceEnabled={resolvedCommerceEnabled} />
    {showLaunchCampaign && (
      <aside class="launch-campaign" aria-label="AI for Normal People launch">
        <div class="shell">
          <strong>Releases <time datetime="2026-10-29">29 October 2026</time></strong>
          <span aria-hidden="true"> · </span>
          <a href="/preview/">Read the free preview</a>
          <span aria-hidden="true"> · </span>
          <a href="#launch-list">Join the launch list for 80% off the direct digital edition</a>
        </div>
      </aside>
    )}
    <main id="main-content">
      <slot />
    </main>
    <Footer {turnstileSiteKey} />
  </body>
</html>

<style>
  .launch-campaign { padding: 1rem 0; background: var(--surface, #eef3fa); color: #061532; border-bottom: 1px solid #ccd6e4; line-height: 1.7; }
  .launch-campaign a { color: #061532; text-underline-offset: 0.2em; }
</style>
