%%{init: {"flowchart": {"htmlLabels": false}, "themeVariables": {"fontSize": "18px"}}}%%
flowchart TB
    H["More human-led"]
    A["Blank-page breaker<br/>You set the problem<br/>AI suggests starts"]
    B["Variation engine<br/>You give a direction<br/>AI offers alternatives"]
    C["Production assistant<br/>You own the plan<br/>AI does a bounded task"]
    D["Co-generator<br/>AI supplies material<br/>You select and reshape"]
    E["AI-led generation<br/>A short instruction<br/>AI fills in the detail"]
    F["Automated content<br/>Many outputs, little<br/>case-by-case attention"]
    M["More AI-led"]
    Q["Authorship, rights,<br/>disclosure and lost-work<br/>questions grow as<br/>you move down"]
    H --> A --> B --> C --> D --> E --> F --> M
    M -.-> Q
    classDef human fill:#e3f2fd,stroke:#1565c0,color:#0d2946
    classDef mixed fill:#fff4d6,stroke:#916700,color:#332500
    classDef machine fill:#fdecea,stroke:#b3261e,color:#410e0b
    classDef note fill:#f5f5f5,stroke:#616161,color:#212121
    class H,A,B,C human
    class D mixed
    class E,F,M machine
    class Q note
