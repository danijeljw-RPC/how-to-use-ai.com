%%{init: {"flowchart": {"htmlLabels": false}, "themeVariables": {"fontSize": "18px"}}}%%
flowchart TB
    H["A claim about<br/>an AI risk"]
    C["1. CAPABILITY<br/>Can AI actually<br/>do this?"]
    P["2. PREVALENCE<br/>Is it really happening,<br/>and how often?"]
    I["3. IMPACT<br/>How much harm when<br/>it does, and to whom?"]
    R["4. RESPONSE<br/>Who can reduce it:<br/>you, an organisation,<br/>or only collective rules?"]
    N["A yes at one step<br/>does not prove<br/>the next step"]
    H --> C --> P --> I --> R
    R ~~~ N
    classDef claim fill:#fdecea,stroke:#b3261e,color:#410e0b
    classDef question fill:#e3f2fd,stroke:#1565c0,color:#0d2946
    classDef note fill:#fff4d6,stroke:#916700,color:#332500
    class H claim
    class C,P,I,R question
    class N note
