%%{init: {"flowchart": {"htmlLabels": false}} }%%
flowchart TB
    A["Your goal"]
    B["Context and<br/>instructions"]
    C["AI generates, transforms,<br/>interprets or acts"]
    D["Output"]
    E["Human judgement:<br/>keep, edit, verify or reject"]
    F["Use the result"]

    A --> B
    B --> C
    C --> D
    D --> E
    E -->|Good enough| F
    E -.->|Not yet: refine| C

    classDef you fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef result fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    class A,E you
    class F result
