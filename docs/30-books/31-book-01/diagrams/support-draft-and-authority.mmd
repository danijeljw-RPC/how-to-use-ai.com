%%{init: {"flowchart": {"htmlLabels": false}, "themeVariables": {"fontSize": "18px"}}}%%
flowchart TB
    A["Customer requests<br/>a service credit"]
    B["AI organises the case<br/>and drafts a reply"]
    C["Worker checks the history<br/>and current guidance"]
    D{"Credit authorised?"}
    E["No: request review<br/>Do not promise a credit"]
    F["Yes: communicate only<br/>the approved outcome"]
    A --> B --> C --> D
    D -->|No| E
    D -->|Yes| F
    classDef assistance fill:#e3f2fd,stroke:#1565c0,color:#0d2946
    classDef human fill:#e8f5e9,stroke:#2e7d32,color:#153b18
    class B assistance
    class C,D,E,F human
