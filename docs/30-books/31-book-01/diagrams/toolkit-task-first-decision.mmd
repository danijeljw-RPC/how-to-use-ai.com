%%{init: {"flowchart": {"htmlLabels": false}, "themeVariables": {"fontSize": "18px"}}}%%
flowchart TB
    T["What job do I<br/>actually need done?"]
    K["Which kind of help fits?<br/>Write and explain<br/>Find and check sources<br/>Make or edit images<br/>Work inside my apps<br/>Help with code<br/>Speak, listen, transcribe"]
    H{"Can something I<br/>already use do it<br/>well enough?"}
    N["Look at one new tool<br/>First-pass check:<br/>need, maker, data,<br/>result, cost and exit"]
    L["Test with a<br/>low-stakes example<br/>you can judge"]
    D{"Worth keeping?<br/>Deeper check before<br/>paying, sharing sensitive<br/>data or connecting accounts"}
    U["Use it, review it<br/>now and then, and<br/>know how to leave"]
    S["Stop: cancel,<br/>delete, revoke access"]
    O["One tool may cover<br/>several kinds of help"]
    T --> K --> H
    H -- "Yes" --> L
    H -- "No" --> N --> L
    L --> D
    D -- "Yes" --> U
    D -- "No" --> S
    K ~~~ O
    classDef start fill:#e3f2fd,stroke:#1565c0,color:#0d2946
    classDef step fill:#eef7ee,stroke:#2e7d32,color:#11331a
    classDef stop fill:#fdecea,stroke:#b3261e,color:#410e0b
    classDef note fill:#fff4d6,stroke:#916700,color:#332500
    class T,K start
    class H,N,L,D,U step
    class S stop
    class O note
