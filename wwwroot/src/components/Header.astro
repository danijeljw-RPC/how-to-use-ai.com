---
interface Props { commerceEnabled?: boolean }
const path = Astro.url.pathname;
const links: Array<[string, string]> = [
  ['/', 'Home'],
  ['/books/', 'Books'],
  ['/preview/', 'Preview'],
  ['/purchase/', 'Purchase'],
  ['/downloads/', 'My books'],
  ['/blog/', 'Blog'],
  ['/contact/', 'Contact'],
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="How-To-Use-AI.com home">
      <span aria-hidden="true">how-to-use-<span class="ai">ai</span>.com</span>
      <span class="caret" aria-hidden="true"></span>
    </a>
    <nav class="nav-menu" aria-label="Primary navigation">
      <ul>
        {links.map(([href, label]) => (
          <li><a href={href} aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
