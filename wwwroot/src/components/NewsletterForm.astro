---
interface Props { sourcePage: string; siteKey?: string }
const { sourcePage, siteKey = '' } = Astro.props;
---

<form class="stack-form newsletter-form" action="/api/newsletter/" method="post" data-progressive-form>
  <input type="hidden" name="sourcePage" value={sourcePage} />
  <div class="field-row">
    <div class="field grow">
      <label for="newsletter-email">Email address</label>
      <input id="newsletter-email" name="email" type="email" autocomplete="email" maxlength="254" required />
    </div>
    <button type="submit">Record my address</button>
  </div>
  <label class="check-row" for="newsletter-consent">
    <input id="newsletter-consent" name="consent" type="checkbox" value="yes" required />
    <span>I agree to have this address stored for launch and coupon notifications.</span>
  </label>
  {siteKey ? (
    <div class="cf-turnstile" data-sitekey={siteKey} data-action="newsletter-signup" data-response-field-name="turnstileToken"></div>
  ) : (
    <p class="form-note">Bot verification is not configured in this environment, so signup will fail closed.</p>
  )}
  <p class="form-status" aria-live="polite" data-form-status></p>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-progressive-form]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!status || !button) return;
      status.textContent = 'Recording…';
      button.disabled = true;
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const result = await response.json() as { message?: string; error?: string };
        status.textContent = result.message ?? result.error ?? 'The form could not be submitted.';
        if (response.ok) form.reset();
      } catch {
        status.textContent = 'The form could not reach the site. Please try again.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
