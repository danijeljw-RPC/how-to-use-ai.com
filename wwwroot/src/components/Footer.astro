---
import NewsletterForm from './NewsletterForm.astro';
interface Props { turnstileSiteKey?: string }
const { turnstileSiteKey = '' } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <section aria-labelledby="footer-newsletter-title">
      <p class="kicker">Launch notes, minus the noise</p>
      <h2 id="footer-newsletter-title">Hear when the book or a coupon is ready.</h2>
      <p>Each signup records your address. No email is sent automatically from this site.</p>
      <NewsletterForm sourcePage={Astro.url.pathname} siteKey={turnstileSiteKey} />
    </section>
    <div class="footer-links">
      <p><strong>How To Use AI.com</strong><br />Understand. Explore. Apply. Grow.</p>
      <nav aria-label="How To Use AI.com legal links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/refund/">Refunds</a>
      </nav>
      <p class="footer-legal-heading">RePass Cloud policies</p>
      <nav aria-label="RePass Cloud legal links">
        <a href="https://repasscloud.com/legal/privacy-policy/">Privacy policy</a>
        <a href="https://repasscloud.com/legal/terms-of-service/">Terms of service</a>
        <a href="https://repasscloud.com/legal/refund-policy/">Refund policy</a>
        <a href="https://repasscloud.com/contact/">Contact</a>
      </nav>
      <p class="footer-operator">How To Use AI.com is operated and published by RePass Cloud Pty Ltd, ABN 74642243801.</p>
      <p class="footer-copyright">© 2026 RePass Cloud Pty Ltd. How To Use AI.com. All rights reserved.</p>
    </div>
  </div>
</footer>
