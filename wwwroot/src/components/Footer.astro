---
import NewsletterForm from './NewsletterForm.astro';
interface Props { turnstileSiteKey?: string }
const { turnstileSiteKey = '' } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <section id="launch-list" aria-labelledby="footer-newsletter-title">
      <p class="kicker">Launch notes, minus the noise</p>
      <h2 id="footer-newsletter-title">Join the launch list and get 80% off the digital edition at release.</h2>
      <p><strong>Releases <time datetime="2026-10-29">29 October 2026</time></strong></p>
      <p>Join before launch and I’ll email you an 80% discount code for the direct digital edition. No weekly newsletter. No inbox filler.</p>
      <NewsletterForm sourcePage={Astro.url.pathname} siteKey={turnstileSiteKey} />
    </section>
    <div class="footer-links">
      <p><strong>How-To-Use-AI.com</strong><br />Understand. Explore. Apply. Grow.</p>
      <nav aria-label="How-To-Use-AI.com legal links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/refund/">Refunds</a>
      </nav>
      <p class="footer-operator">How-To-Use-AI.com is operated and published by RePass Cloud Pty Ltd, ABN 74642243801.</p>
      <p class="footer-copyright">© 2026 RePass Cloud Pty Ltd. How-To-Use-AI.com. All rights reserved.</p>
    </div>
  </div>
</footer>
