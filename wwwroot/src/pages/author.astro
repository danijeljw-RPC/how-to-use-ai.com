---
import { Image, getImage } from 'astro:assets';
import portrait from '../../../assets/author/author-photo.jpg';
import publishing from '../../../publishing/books.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { bookOne } from '../content/books';

export const prerender = true;
const authorUrl = 'https://how-to-use-ai.com/author/';
const personId = `${authorUrl}#person`;
const orcidUrl = 'https://orcid.org/0009-0003-5304-1340';
const bookUrl = 'https://how-to-use-ai.com/books/ai-for-normal-people/';
const bookId = `${bookUrl}#book`;
const editions = Object.entries(publishing.books[0].editions).filter(([, edition]) => edition.enabled && edition.isbn);
const photo = await getImage({ src: portrait, width: 720, format: 'webp' });
const biography = 'Danijel-James Wynyard-McClay (DJ) is a software engineer, writer and podcaster based in Adelaide, Australia. He created How-To-Use-AI.com to help people understand artificial intelligence, use it thoughtfully and judge its claims for themselves.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ProfilePage', '@id': authorUrl, url: authorUrl, name: `About ${site.author}`, mainEntity: { '@id': personId } },
    {
      '@type': 'Person', '@id': personId, name: site.author, alternateName: 'DJ',
      url: authorUrl, sameAs: [orcidUrl], image: new URL(photo.src, Astro.site).href,
      description: biography, jobTitle: 'Software engineer, writer and podcaster',
      knowsAbout: ['Software engineering', 'Artificial intelligence', 'Cloud infrastructure', 'Automation', 'Systems integration'],
      mainEntityOfPage: { '@id': authorUrl },
      contactPoint: { '@type': 'ContactPoint', contactType: 'Media and interview enquiries', url: 'https://how-to-use-ai.com/contact/' },
    },
    {
      '@type': 'Book', '@id': bookId, name: bookOne.title, alternateName: bookOne.subtitle,
      url: bookUrl, description: bookOne.summary, inLanguage: 'en', datePublished: '2026-10-29',
      author: { '@id': personId }, publisher: { '@type': 'Organization', name: publishing.series.publisher.name },
      workExample: editions.map(([key]) => ({ '@id': `${bookId}-${key}` })),
    },
    ...editions.map(([key, edition]) => ({
      '@type': 'Book', '@id': `${bookId}-${key}`, name: bookOne.title,
      bookEdition: edition.editionLine, isbn: edition.isbn,
      bookFormat: edition.type === 'print' ? 'https://schema.org/Paperback' : 'https://schema.org/EBook',
      author: { '@id': personId }, exampleOfWork: { '@id': bookId }, url: bookUrl,
    })),
  ],
};
---
<BaseLayout title={`About ${site.author}`} description={biography} canonicalPath="/author/" {structuredData}>
  <section class="page-section">
    <div class="shell author-introduction">
      <Image src={portrait} width={720} format="webp" alt="Portrait of Danijel-James Wynyard-McClay" loading="eager" class="author-portrait" />
      <div>
        <p class="kicker">Meet the author</p>
        <h1>{site.author}</h1>
        <p class="section-intro">Software engineer. Writer. Curious about what actually works.</p>
        <p>{biography}</p>
        <p><a href={orcidUrl} rel="me">ORCID: 0009-0003-5304-1340</a></p>
        <p>His approach combines practical experience, evidence and healthy scepticism. He writes for readers who want enough understanding to make their own decisions, without needing to become AI specialists.</p>
        <a href="#media">Media and interview enquiries</a>
      </div>
    </div>
  </section>
  <section class="page-section">
    <div class="narrow">
      <h2>Technical background</h2>
      <p>DJ’s work spans software engineering, cloud infrastructure, automation, systems integration, security and monitoring. His background in technology predates the current AI boom, and includes a PhD in Computer Science with a thesis in artificial intelligence and machine learning.</p>
      <p>That technical background informs his writing, but does not dictate the reader’s starting point. <em>AI for Normal People</em> deliberately begins with everyday experiences and plain English.</p>
      <h2>Other work</h2>
      <p>He also created <a href="https://usefulstash.com" target="_blank" rel="noopener noreferrer">Useful Stash</a>, a technology publication about software, tools, automation and lessons from building things, and co-hosts the podcast <a href="https://sisterswithmirrors.com" target="_blank" rel="noopener noreferrer"><em>Sisters With Mirrors</em></a>.</p>
      <h2>Books</h2>
      <h3><a href="/books/ai-for-normal-people/">{bookOne.title}</a></h3>
      <p>{bookOne.subtitle}</p>
      <p>Book 1 in the How-To-Use-AI.com series. Published by {publishing.series.publisher.name}. Scheduled for publication on <time datetime="2026-10-29">29 October 2026</time>.</p>
      <p>{bookOne.summary}</p>
      <div class="isbn-table"><table>
        <caption>Edition ISBNs</caption>
        <thead><tr><th scope="col">Format</th><th scope="col">ISBN</th></tr></thead>
        <tbody>{editions.map(([, edition]) => <tr><th scope="row">{edition.label}</th><td>{edition.isbnDisplay}</td></tr>)}</tbody>
      </table></div>
      <h2>Interviews and independent reviews</h2>
      <p>No interviews or independent reviews are listed here yet.</p>
      <h2 id="media">Media contact</h2>
      <p>For interviews, review copies or questions about the author and his books, <a href="/contact/">use the contact form</a>. Include “Media enquiry” in the subject, your publication or programme, and any deadline.</p>
    </div>
  </section>
</BaseLayout>
<style>
  .author-introduction { display: grid; grid-template-columns: minmax(220px, 340px) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .author-portrait { width: 100%; height: auto; border-radius: 1rem; }
  h1 { overflow-wrap: anywhere; }
  h2 { margin-top: 2.5rem; }
  .isbn-table { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  caption { text-align: left; margin-bottom: .75rem; font-weight: bold; }
  th, td { text-align: left; padding: .75rem; border-bottom: 1px solid var(--border, #a1a1aa); }
  td { white-space: nowrap; }
  @media (max-width: 700px) { .author-introduction { grid-template-columns: 1fr; } .author-portrait { max-width: 340px; } }
</style>
