---
import { siteEnv } from '../lib/runtime-env';
import { bookOne } from '../content/books';
import { kindlePreorderLinks } from '../content/retailers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCommerceConfig, getRetailers } from '../lib/config';
const env = siteEnv();
const commerce = getCommerceConfig(env);
const retailers = getRetailers(env);
---
<BaseLayout title="Purchase options" description="Current configured purchase options for AI for Normal People." canonicalPath="/purchase/" commerceEnabled={commerce.enabled}>
  <section class="page-section">
    <div class="narrow">
      <p class="kicker">Purchase options</p>
      <h1>{bookOne.title}</h1>
      <p class="section-intro">The Kindle Edition is available to pre-order on Amazon. Choose your regional store below.</p>
      <section aria-labelledby="kindle-title">
        <h2 id="kindle-title">Pre-order the Kindle Edition</h2>
        <p>Amazon handles your pre-order and delivers the Kindle Edition to your Kindle library. For the price and release date, see your regional listing.</p>
        <ul class="retailer-list">
          {kindlePreorderLinks.map((retailer) => <li><a class="button secondary" href={retailer.url} target="_blank" rel="external noopener noreferrer">Amazon · {retailer.label}</a></li>)}
        </ul>
      </section>
      <section aria-labelledby="other-editions-title">
        <h2 id="other-editions-title">Other ebook stores</h2>
        <p>Google Play Books and Apple Books links will be added here when available.</p>
      </section>
      {!commerce.enabled && (
        <section aria-labelledby="direct-planned-title">
          <h2 id="direct-planned-title">Buy directly from this store</h2>
          <p>Direct sales are being prepared for these editions:</p>
          <ul>
            <li>PDF download</li>
            <li>EPUB download</li>
            <li>Black and white paperback</li>
            <li>Colour paperback</li>
          </ul>
          <p>These editions are not yet available to buy here. You can read the preview now or sign up below for availability updates.</p>
          <div class="button-row"><a class="button" href="/api/preview/">Read today’s preview</a></div>
        </section>
      )}
      {retailers.length > 0 && (
        <section aria-labelledby="retailer-title">
          <h2 id="retailer-title">More purchase options</h2>
          <ul class="retailer-list">
            {retailers.map((retailer) => <li><a class="button secondary" href={retailer.url} target="_blank" rel="external noopener noreferrer">View at {retailer.label}</a></li>)}
          </ul>
        </section>
      )}
      {commerce.enabled && (
        <section aria-labelledby="direct-title">
          <h2 id="direct-title">Direct checkout</h2>
          <p>Continue to secure checkout to place your order.</p>
          <form action="/api/checkout/" method="post">
            <button type="submit" name="format" value="ebook">Continue to ebook checkout</button>
          </form>
          {commerce.prices.print && (
            <form action="/api/checkout/" method="post">
              <button type="submit" name="format" value="print">Continue to print checkout</button>
            </form>
          )}
        </section>
      )}
    </div>
  </section>
</BaseLayout>
