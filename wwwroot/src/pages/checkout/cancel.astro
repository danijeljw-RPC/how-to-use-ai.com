---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Checkout cancelled" description="Return to the site after leaving checkout without completing it." canonicalPath="/checkout/cancel/" robots="noindex, nofollow">
  <section class="page-section">
    <div class="narrow">
      <p class="kicker">Checkout return</p>
      <h1>No purchase is claimed here.</h1>
      <p class="section-intro">You left the checkout flow. You can return to the purchase options or continue reading the preview.</p>
      <div class="button-row">
        <a class="button secondary" href="/purchase/">Purchase options</a>
        <a class="button secondary" href="/api/preview/">Read the preview</a>
      </div>
    </div>
  </section>
</BaseLayout>
