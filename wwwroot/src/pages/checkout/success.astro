---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Payment being confirmed" description="A checkout return page while signed payment confirmation is processed." canonicalPath="/checkout/success/" robots="noindex, nofollow">
  <section class="page-section">
    <div class="narrow">
      <p class="kicker">Checkout return</p>
      <h1>Payment is being confirmed.</h1>
      <p class="section-intro">Returning here does not prove that payment or fulfilment has completed. The signed Stripe event is the authoritative confirmation.</p>
      <p><a class="button secondary" href="/">Return home</a></p>
    </div>
  </section>
</BaseLayout>
