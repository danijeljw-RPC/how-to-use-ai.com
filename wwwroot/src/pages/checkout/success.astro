---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Payment being confirmed" description="A checkout return page while signed payment confirmation is processed." canonicalPath="/checkout/success/" robots="noindex, nofollow">
  <section class="page-section">
    <div class="narrow">
      <p class="kicker">Checkout return</p>
      <h1>Payment is being confirmed.</h1>
      <p class="section-intro">Your book will appear in your library once payment is confirmed. We will also email you a link. Some payment methods take longer to confirm.</p>
      <p><a class="button secondary" href="/downloads/">Open my book library</a></p>
    </div>
  </section>
</BaseLayout>
