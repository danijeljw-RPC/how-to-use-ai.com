---
import { siteEnv } from '../lib/runtime-env';
import BaseLayout from '../layouts/BaseLayout.astro';
import { storeReady } from '../lib/store/types';
const commerceEnabled = storeReady(siteEnv());
---
<BaseLayout title="Book preview" description="Read the free PDF preview of AI for Normal People without joining a mailing list." canonicalPath="/preview/" {commerceEnabled}>
  <section class="page-section">
    <div class="narrow">
      <p class="kicker">Read before you buy</p>
      <h1>Read a sample of AI for Normal People.</h1>
      <p><strong>Releases <time datetime="2026-10-29">29 October 2026</time></strong></p>
      <p class="section-intro">The book is complete. This free PDF gives you a sample of its plain-English explanations and practical approach. You do not need to provide an email address to read it.</p>
      <div class="button-row">
        <a class="button" href="/api/preview/">Open the free PDF preview</a>
        <a class="button secondary" href="/books/ai-for-normal-people/">About Book 1</a>
      </div>
      <p class="muted preview-followup">Explore all four parts and 14 chapters on the book page, or visit the purchase page for available editions.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .preview-followup { margin-top: 1.5rem; }
</style>
