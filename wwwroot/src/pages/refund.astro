---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';

const policy = await getEntry('legal', 'refund-policy');
if (!policy) throw new Error('Missing How-To-Use-AI.com refund policy');
const { Content } = await render(policy);
---

<LegalLayout
  title="Refund Policy"
  description="Refunds, replacements, returns, and consumer remedies for purchases made directly from How-To-Use-AI.com."
  canonicalPath="/refund/"
>
  <Content />
  <section aria-labelledby="store-policy-note"><h2 id="store-policy-note">Duplicate purchases and download access</h2><p>The store checks your existing digital purchases before checkout to help prevent duplicate orders. If a sign-in or download link has expired, visit your book library for a fresh link rather than buying again. For a purchase or delivery problem, use the <a href="/contact/?subject=purchase-support">purchase support form</a>. The refund policy above continues to apply.</p><p><a href="/downloads/">Open your book library</a></p></section>
</LegalLayout>
