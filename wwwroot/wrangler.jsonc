{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "how-to-use-ai",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "how-to-use-ai.com", "custom_domain": true },
    { "pattern": "www.how-to-use-ai.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_URL": "https://how-to-use-ai.com",
    "PREVIEW_DOWNLOAD_URL": "https://how-to-use-ai.com/downloads/ai-for-normal-people-preview.pdf",
    "COMMERCE_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFB56_6HtJDzcLZi",
    "STRIPE_PRICE_EBOOK": "price_1UJ6TX4BF2uOrrJb7uyZM1iR"
  },
  // Production only. Local development uses Wrangler's local D1 simulation; there is no remote dev database.
  "d1_databases": [
    {
      "binding": "SITE_DB",
      "database_name": "how-to-use-ai-site",
      "database_id": "681b856b-e2b1-4eea-8ec0-1d355ec0c770",
      "migrations_dir": "migrations"
    }
  ]
}
