{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "how-to-use-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "preview_urls": false,
  "routes": [
    { "pattern": "how-to-use-ai.com", "custom_domain": true },
    { "pattern": "www.how-to-use-ai.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    "SITE_URL": "https://how-to-use-ai.com",
    "PREVIEW_DOWNLOAD_URL": "https://how-to-use-ai.com/downloads/ai-for-normal-people-preview.pdf",
    "COMMERCE_ENABLED": "false",
    "STORE_MODE": "live",
    "STORE_PRODUCT_BUNDLE": "prod_VOw3pCwEzsPFNZ",
    "STORE_PRODUCT_EPUB": "prod_VOw3gfJLYIp2FM",
    "STORE_PRODUCT_PDF": "prod_VOw3SCfzB4NhuD",
    "STORE_PRODUCT_SIGNED": "prod_VOw34dLBWMnu6y",
    "STORE_PRODUCT_SIGNED_COLOUR": "prod_VOw38xo8MnyjQg",
    "STORE_EMAIL_READY": "false",
    "STORE_ORDER_NOTIFY_EMAIL": "",
    "BOOK_PDF_KEY": "book-01/current/ai-for-normal-people.pdf",
    "BOOK_EPUB_KEY": "book-01/current/ai-for-normal-people.epub",
    "STORE_SIGNED_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFB56_6HtJDzcLZi"
  },
  "r2_buckets": [{ "binding": "BOOK_FILES", "bucket_name": "how-to-use-ai-books" }],
  // Production only. Local development uses Wrangler's local D1 simulation; there is no remote dev database.
  "d1_databases": [
    {
      "binding": "SITE_DB",
      "database_name": "how-to-use-ai-site",
      "database_id": "681b856b-e2b1-4eea-8ec0-1d355ec0c770",
      "migrations_dir": "migrations"
    }
  ]
}
