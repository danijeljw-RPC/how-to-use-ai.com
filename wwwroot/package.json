{
  "name": "how-to-use-ai-launch-site",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "vitest run",
    "test:watch": "vitest",
