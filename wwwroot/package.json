    "deploy:dry-run": "astro build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.4",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  },
  "allowScripts": {
    "workerd@1.20260921.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true,
    "fsevents@2.3.3": true
  }
